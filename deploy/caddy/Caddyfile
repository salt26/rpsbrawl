{
	admin off
	persist_config off
	servers {
		protocols h1 h2
	}
}

# 로그인 토큰이 주소에 들어가므로 접속 기록을 남기지 않는다(Caddy는 log를 적지 않으면 남기지 않는다).

# API와 WebSocket. Cloudflare "DNS only"라 브라우저가 직접 접속한다.
# X-Forwarded-For는 Caddy가 실제 접속 IP 하나로 덮어쓴다(토큰이 이 값에 묶인다).
# Cloudflare 프록시를 다시 켜려면: 이 이름도 Origin 인증서(tls 줄)를 쓰고,
# reverse_proxy 안에 header_up X-Forwarded-For {header.CF-Connecting-IP} 를 넣는다.
rpsbrawl-api.ravitastudio.com {
	request_body {
		max_size 16KB
	}
	reverse_proxy rpsbrawl-web:80
}

# 웹 클라이언트. Cloudflare 프록시를 거치므로 Cloudflare에서 온 요청만 받는다.
# 대역 목록: https://www.cloudflare.com/ips-v4 (2026-11-25)
rpsbrawl.ravitastudio.com {
	tls /certs/origin-cert.pem /certs/origin-key.pem
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	handle @cloudflare {
		reverse_proxy rpsbrawl-web:80
	}
	handle {
		abort
	}
}
